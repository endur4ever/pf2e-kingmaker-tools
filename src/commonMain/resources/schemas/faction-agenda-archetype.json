{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://posselt.at/pf2e-kingmaker-tools/schemas/faction-agenda-archetype.json",
  "title": "FactionAgendaArchetype",
  "description": "One archetype's weighted move table and goal pool",
  "type": "object",
  "required": [
    "id",
    "weights",
    "goals"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "enum": [
        "aggressive",
        "mercantile",
        "fey",
        "political",
        "monster"
      ]
    },
    "weights": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    }
  }
}
