<div class="km-holding-offer-card">
    <h3><i class="fa-solid fa-trowel-bricks"></i> {{title}}</h3>
    <p>{{line}}</p>
    <div class="km-rumor-offer-buttons">
        <button type="button" class="km-offer-holding-repair"
                data-kingdom-actor-uuid="{{actorUuid}}"
                data-holding-id="{{holdingId}}"
                data-from-condition="{{fromCondition}}"
                data-cost="{{cost}}">{{repairLabel}}</button>
    </div>
</div>
