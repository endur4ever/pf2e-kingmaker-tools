<div class="km-holding-offer-card">
    <h3><i class="fa-solid fa-house-crack"></i> {{title}}</h3>
    <p>{{line}}</p>
    <div class="km-rumor-offer-buttons">
        <button type="button" class="km-offer-holding-damage"
                data-kingdom-actor-uuid="{{actorUuid}}"
                data-holding-id="{{holdingId}}"
                data-from-condition="{{fromCondition}}"
                data-severity="{{severity}}"
                data-cause="{{cause}}">{{applyLabel}}</button>
        <button type="button" class="km-waive-holding-damage"
                data-kingdom-actor-uuid="{{actorUuid}}">{{waiveLabel}}</button>
    </div>
</div>
