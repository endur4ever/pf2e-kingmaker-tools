<div class="km-loot-award-card">
    <h3><i class="fa-solid fa-gem"></i> {{title}}</h3>
    <p class="km-loot-award-source">{{sourceLabel}} — {{summary}}</p>
    <ul class="km-loot-award-list">
        {{#each rows}}
            <li{{#if this.cursed}} class="km-loot-cursed"{{/if}}>
                {{{this.link}}} <span class="km-loot-detail">{{this.detail}}</span>
            </li>
        {{/each}}
    </ul>
    <div class="km-loot-award-buttons">
        <button type="button" class="km-offer-loot-award"
                data-kingdom-actor-uuid="{{actorUuid}}"
                data-content-id="{{contentId}}">{{awardLabel}}</button>
        <button type="button" class="km-offer-loot-dismiss"
                data-kingdom-actor-uuid="{{actorUuid}}"
                data-content-id="{{contentId}}">{{dismissLabel}}</button>
    </div>
</div>
