<div class="km-chat-card km-seasonal-flood-offer">
    <h3><i class="fa-solid fa-water"></i> {{localizeKM "kingdom.seasonalEconomy.flood.offerTitle"}}</h3>
    <p>{{localizeKM "kingdom.seasonalEconomy.flood.offerBody"}}</p>
    <div class="km-chat-buttons">
        <button type="button" class="km-offer-seasonal-flood" data-kingdom-actor-uuid="{{actorUuid}}">
            {{localizeKM "kingdom.seasonalEconomy.flood.spawnEvent"}}
        </button>
        <button type="button" class="km-offer-seasonal-flood-dismiss" data-kingdom-actor-uuid="{{actorUuid}}">
            {{localizeKM "kingdom.seasonalEconomy.flood.dismiss"}}
        </button>
    </div>
</div>
