<div class="km-caravan-war-offer">
    <h3>{{localizeKM "kingdom.caravans.warOfferTitle"}}</h3>
    <p>{{localizeKM "kingdom.caravans.warDeclaredOffer" partner=partner}}</p>
    <p><strong>{{summary}}</strong></p>
    <div class="km-offer-buttons">
        <button type="button" class="km-offer-caravan-recall" data-kingdom-actor-uuid="{{actorUuid}}" data-caravan-id="{{caravanId}}" data-action="recall">
            <i class="fa-solid fa-rotate-left"></i> {{localizeKM "kingdom.caravans.caravanWarOfferRecall"}}
        </button>
        <button type="button" class="km-offer-caravan-press-on" data-kingdom-actor-uuid="{{actorUuid}}" data-caravan-id="{{caravanId}}" data-action="press-on">
            <i class="fa-solid fa-arrow-up-right-from-square"></i> {{localizeKM "kingdom.caravans.caravanWarOfferPressOn"}}
        </button>
    </div>
</div>