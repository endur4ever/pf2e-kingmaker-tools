<div class="km-meanwhile-interlude">
    <header class="km-meanwhile-header">
        <h3><i class="fa-solid fa-scroll"></i> {{title}}</h3>
        <span class="km-meanwhile-turn">{{turnLabel}}</span>
    </header>
    <ul class="km-meanwhile-beats">
        {{#each beats}}
            <li>{{this}}</li>
        {{/each}}
    </ul>
</div>
