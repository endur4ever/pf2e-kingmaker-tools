<h2>{{localizeKM "chatMessages.warRuin.offerTitle"}}</h2>
<div class="km-war-pressure-ruin-offer">
    <p>{{localizeKM "chatMessages.warRuin.offerBody"}}</p>
</div>
<hr>
<h3>{{localizeKM "chatMessages.companionAutonomy.gmActions"}}</h3>
<div class="km-expedition-offers">
    <button type="button"
            class="km-offer-war-ruin"
            data-kingdom-actor-uuid="{{actorUuid}}"
            data-turn="{{turn}}"
            data-choice="corruption">
        {{localizeKM "chatMessages.warRuin.corruption"}}
    </button>
    <button type="button"
            class="km-offer-war-ruin"
            data-kingdom-actor-uuid="{{actorUuid}}"
            data-turn="{{turn}}"
            data-choice="crime">
        {{localizeKM "chatMessages.warRuin.crime"}}
    </button>
    <button type="button"
            class="km-offer-war-ruin"
            data-kingdom-actor-uuid="{{actorUuid}}"
            data-turn="{{turn}}"
            data-choice="decay">
        {{localizeKM "chatMessages.warRuin.decay"}}
    </button>
    <button type="button"
            class="km-offer-war-ruin"
            data-kingdom-actor-uuid="{{actorUuid}}"
            data-turn="{{turn}}"
            data-choice="strife">
        {{localizeKM "chatMessages.warRuin.strife"}}
    </button>
    <button type="button"
            class="km-offer-war-ruin"
            data-kingdom-actor-uuid="{{actorUuid}}"
            data-turn="{{turn}}"
            data-choice="dismiss">
        {{localizeKM "chatMessages.warRuin.dismiss"}}
    </button>
</div>
