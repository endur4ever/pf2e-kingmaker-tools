<div>
    {{> tabs tabs}}
    <div class="km-settlement-content">
        <div {{#unless (eq currentTab 'status')}}hidden{{/unless}}>
            <table class="km-settlement-status">
                <tbody>
                <tr>
                    <th>{{localizeKM "kingdom.manualManagement"}}</th>
                    <td>{{> formElement manualSettlementLevelInput}}</td>
                </tr>
                <tr>
                    <th>{{localizeKM "enums.settlementType" }}</th>
                    <td>{{> formElement typeInput}}</td>
                </tr>
                <tr>
                    <th>{{localizeKM "enums.settlementLayoutType" }}</th>
                    <td>{{> formElement layoutInput}}</td>
                </tr>
                {{# if settlementActions}}
                    <tr>
                        <th>{{localizeKM "kingdom.settlementActions"}}</th>
                        <td>{{settlementActions}}</td>
                    </tr>
                {{/if}}
                <tr>
                    <th>{{localizeKM "kingdom.blocksWithMaximum" count=maximumBlocks}}</th>
                    <td>
                        {{> formElement blocksInput}}
                        {{#unless manualSettlementLevel}}
                            {{blocks}}
                        {{/unless}}</td>
                </tr>
                <tr>
                    <th>{{localizeKM "kingdom.population.title"}}</th>
                    <td>{{population}}</td>
                </tr>
                <tr>
                    <th>{{localizeKM "kingdom.residentialLots"}}</th>
                    <td>{{residentialLots}}</td>
                </tr>
                <tr>
                    <th>{{localizeKM "applications.level"}}</th>
                    <td>
                        {{level}}
                    </td>
                </tr>
                <tr>
                    <th>{{localizeKM "kingdom.consumption"}}</th>
                    <td>{{consumption}} {{#if consumptionSurplus}}({{localizeKM "kingdom.surplus"}}: {{consumptionSurplus}}){{/if}}</td>
                </tr>
                <tr>
                    <th>{{localizeKM "kingdom.maxItemBonus"}}</th>
                    <td>{{maxItemBonus}}</td>
                </tr>
                <tr>
                    <th>{{localizeKM "kingdom.influence"}}</th>
                    <td>{{influence}}</td>
                </tr>
                <tr>
                    <th>{{localizeKM "kingdom.capitalInvestment"}}</th>
                    <td>{{#if allowCapitalInvestment}}<i class="fa-solid fa-circle-check"></i>{{/if}}</td>
                </tr>
                <tr>
                    <th>{{localizeKM "kingdom.secondaryTerritory"}}</th>
                    <td>{{> formElement secondaryTerritoryInput}}</td>
                </tr>
                <tr>
                    <th>{{localizeKM "kingdom.waterBorders"}}</th>
                    <td>{{> formElement waterBordersInput}}</td>
                </tr>
                <tr>
                    <th>{{localizeKM "kingdom.lacksBridge"}}</th>
                    <td>{{#if lacksBridge}}{{localizeKM "yes"}}{{else}}{{localizeKM "no"}}{{/if}}</td>
                </tr>
                <tr>
                    <th>{{localizeKM "kingdom.overcrowded"}}</th>
                    <td>{{#if isOvercrowded}}{{localizeKM "yes"}}{{else}}{{localizeKM "no"}}{{/if}}</td>
                </tr>
                </tbody>
            </table>
            <button type="submit" class="full-width" data-action="km-save"
                    {{#unless isFormValid}}disabled{{/unless}}>{{#if
                    saveLabel}}{{saveLabel}}{{else}}{{localizeKM "applications.save"}}{{/if}}</button>
        </div>
        <div {{#unless (eq currentTab 'shopping')}}hidden{{/unless}}>
            <table>
                <thead>
                <th>{{localizeKM "kingdom.itemType"}}</th>
                <th>{{localizeKM "kingdom.maxItemLevel"}}</th>
                </thead>
                <tbody>
                {{#each availableItems}}
                    <tr>
                        <td>{{@key}}</td>
                        <td>{{this}}</td>
                    </tr>
                {{/each}}
                </tbody>
            </table>
            <div class="km-unlocked-access-section" style="margin-top: 15px;">
                <h3>{{localizeKM "kingdom.settlementUnlockedAccess"}}</h3>
                <table class="km-unlocked-access-table">
                    <tbody>
                        <tr>
                            <th>{{localizeKM "kingdom.settlementItemPurchaseLevel"}}</th>
                            <td>Level {{itemPurchaseLevel}}</td>
                        </tr>
                        <tr>
                            <th>{{localizeKM "kingdom.settlementTrainers"}}</th>
                            <td>
                                {{#if trainers.length}}
                                    <ul>
                                        {{#each trainers}}
                                            <li>{{this}}</li>
                                        {{/each}}
                                    </ul>
                                {{else}}
                                    {{localizeKM "kingdom.settlementNone"}}
                                {{/if}}
                            </td>
                        </tr>
                        <tr>
                            <th>{{localizeKM "kingdom.settlementCraftingAccess"}}</th>
                            <td>
                                {{#if craftingAccess.length}}
                                    <ul>
                                        {{#each craftingAccess}}
                                            <li>{{this}}</li>
                                        {{/each}}
                                    </ul>
                                {{else}}
                                    {{localizeKM "kingdom.settlementNone"}}
                                {{/if}}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div {{#unless (eq currentTab 'bonuses')}}hidden{{/unless}}>
            <ul>
                {{#each bonuses}}
                    <li>{{this}}</li>
                {{/each}}
            </ul>
        </div>
        <div {{#unless (eq currentTab 'storage')}}hidden{{/unless}}>
            <table>
                {{#each storage}}
                    <tr>
                        <td>{{label}}</td>
                        <td>{{value}}</td>
                    </tr>
                {{/each}}
            </table>
        </div>
        <div {{#unless (eq currentTab 'structures')}}hidden{{/unless}}>
            <ul>
                {{#each structures}}
                    <li>{{value}}x {{{label}}}</li>
                {{/each}}
            </ul>
        </div>
        <div {{#unless (eq currentTab 'notes')}}hidden{{/unless}}>
            <ul>
                {{#each notes}}
                    <li>{{this}}</li>
                {{/each}}
            </ul>
        </div>
        <div {{#unless (eq currentTab 'population')}}hidden{{/unless}}>
            <div class="km-population-roster">
                <div class="km-population-header">
                    <h3><i class="fa-solid fa-users"></i> {{localizeKM "kingdom.population.title"}}</h3>
                    <span class="km-header-right-align">
                        <button type="button" data-action="generate-npcs"
                                title="{{localizeKM "kingdom.population.generateNpcsHelp"}}">
                            <i class="fa-solid fa-wand-magic-sparkles"></i> {{localizeKM "kingdom.population.generateNpcs"}}
                        </button>
                        <button type="button" data-action="add-npc">
                            <i class="fa-solid fa-plus"></i> {{localizeKM "kingdom.population.addNpc"}}
                        </button>
                    </span>
                </div>
                {{#if populationNpcs.length}}
                <table class="km-population-table">
                    <thead>
                        <tr>
                            <th>{{localizeKM "kingdom.population.name"}}</th>
                            <th>{{localizeKM "kingdom.population.occupation"}}</th>
                            <th>{{localizeKM "kingdom.population.notes"}}</th>
                            <th>{{localizeKM "applications.actions"}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each populationNpcs}}
                        <tr>
                            <td>{{this.name}}</td>
                            <td>{{this.occupation}}</td>
                            <td>{{#if this.notes}}{{this.notes}}{{else}}&mdash;{{/if}}</td>
                            <td class="km-population-actions">
                                <button type="button" data-action="edit-npc" data-index="{{@index}}" title="{{localizeKM 'applications.edit'}}">
                                    <i class="fa-solid fa-pencil"></i>
                                </button>
                                <button type="button" data-action="delete-npc" data-index="{{@index}}" title="{{localizeKM 'applications.delete'}}">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
                {{else}}
                <div class="km-empty-population">
                    <i class="fa-regular fa-folder-open"></i>
                    <p>{{localizeKM "kingdom.population.empty"}}</p>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</div>