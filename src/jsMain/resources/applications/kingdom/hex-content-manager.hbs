<div class="km-hex-content-manager">
    {{#if isEditing}}
        <div class="km-hex-content-form">
            <h3>{{localizeKM "kingdom.hexContent.editContent"}}</h3>
            {{#each formRows}}
                {{> formElement this}}
            {{/each}}
            <div class="km-hex-links">
                {{#if linkedQuestChoices.length}}
                <div class="km-hex-links-group">
                    <label class="km-hex-links-label"><i class="fa-solid fa-scroll"></i> {{localizeKM "kingdom.hexContent.linkedQuests"}}</label>
                    <div class="km-hex-quest-choices">
                        {{#each linkedQuestChoices}}
                        <label class="km-hex-quest-choice">
                            <input type="checkbox" name="questLink" value="{{this.id}}" {{#if this.checked}}checked{{/if}}>
                            <span>{{this.title}}</span>
                        </label>
                        {{/each}}
                    </div>
                </div>
                {{/if}}
                <div class="km-hex-links-group">
                    <label class="km-hex-links-label"><i class="fa-solid fa-link"></i> {{localizeKM "kingdom.hexContent.linkedDocuments"}}</label>
                    <div class="km-hex-drop-zone">
                        <i class="fa-solid fa-hand-pointer"></i> {{localizeKM "kingdom.hexContent.dropHint"}}
                    </div>
                    <div class="km-hex-link-list">
                        {{#each linkedDocs}}
                        <span class="km-hex-link-chip" data-uuid="{{this.uuid}}">
                            {{{this.link}}}
                            <a class="km-hex-link-remove" data-uuid="{{this.uuid}}" title="{{localizeKM 'kingdom.hexContent.removeLink'}}">×</a>
                        </span>
                        {{/each}}
                    </div>
                <div class="km-hex-links-group km-hex-loot-group">
                    <label class="km-hex-links-label"><i class="fa-solid fa-coins"></i> {{localizeKM "kingdom.hexContent.loot.title"}}
                        {{#if manifestAwarded}}<span class="km-hex-loot-awarded">{{localizeKM "kingdom.hexContent.loot.awardedBadge"}}</span>{{/if}}
                    </label>
                    <div class="km-hex-loot-zone">
                        <i class="fa-solid fa-hand-pointer"></i> {{localizeKM "kingdom.hexContent.loot.dropHint"}}
                    </div>
                    <div class="km-hex-loot-list">
                        {{#each lootRows}}
                        <div class="km-hex-loot-row" data-uuid="{{this.uuid}}" data-name="{{this.name}}">
                            <span class="km-hex-loot-link">{{{this.link}}}</span>
                            <input type="number" class="km-hex-loot-qty" min="0" value="{{this.quantity}}" title="{{localizeKM 'kingdom.hexContent.loot.quantity'}}">
                            <input type="number" class="km-hex-loot-gp" min="0" step="0.01" value="{{this.gpValue}}" title="{{localizeKM 'kingdom.hexContent.loot.gpValue'}}">
                            <label class="km-hex-loot-cursed" title="{{localizeKM 'kingdom.hexContent.loot.cursed'}}">
                                <input type="checkbox" {{#if this.cursed}}checked{{/if}}> {{localizeKM "kingdom.hexContent.loot.cursedShort"}}
                            </label>
                            <input type="text" class="km-hex-loot-note" value="{{this.note}}" placeholder="{{localizeKM 'kingdom.hexContent.loot.note'}}">
                            <a class="km-hex-loot-remove" title="{{localizeKM 'kingdom.hexContent.loot.remove'}}">×</a>
                        </div>
                        {{/each}}
                    </div>
                    <div class="km-hex-loot-summary">{{lootSummary}}</div>
                </div>
                </div>
            </div>
            <div class="km-form-actions">
                <button type="button" class="km-btn km-btn-save" data-action="save">{{localizeKM "kingdom.hexContent.save"}}</button>
                <button type="button" class="km-btn" data-action="cancel-edit">{{localizeKM "kingdom.hexContent.cancel"}}</button>
            </div>
        </div>
    {{else if isAdding}}
        <div class="km-hex-content-form">
            <h3>{{localizeKM "kingdom.hexContent.addContent"}}</h3>
            {{#each formRows}}
                {{> formElement this}}
            {{/each}}
            <div class="km-hex-links">
                {{#if linkedQuestChoices.length}}
                <div class="km-hex-links-group">
                    <label class="km-hex-links-label"><i class="fa-solid fa-scroll"></i> {{localizeKM "kingdom.hexContent.linkedQuests"}}</label>
                    <div class="km-hex-quest-choices">
                        {{#each linkedQuestChoices}}
                        <label class="km-hex-quest-choice">
                            <input type="checkbox" name="questLink" value="{{this.id}}" {{#if this.checked}}checked{{/if}}>
                            <span>{{this.title}}</span>
                        </label>
                        {{/each}}
                    </div>
                </div>
                {{/if}}
                <div class="km-hex-links-group">
                    <label class="km-hex-links-label"><i class="fa-solid fa-link"></i> {{localizeKM "kingdom.hexContent.linkedDocuments"}}</label>
                    <div class="km-hex-drop-zone">
                        <i class="fa-solid fa-hand-pointer"></i> {{localizeKM "kingdom.hexContent.dropHint"}}
                    </div>
                    <div class="km-hex-link-list">
                        {{#each linkedDocs}}
                        <span class="km-hex-link-chip" data-uuid="{{this.uuid}}">
                            {{{this.link}}}
                            <a class="km-hex-link-remove" data-uuid="{{this.uuid}}" title="{{localizeKM 'kingdom.hexContent.removeLink'}}">×</a>
                        </span>
                        {{/each}}
                    </div>
                <div class="km-hex-links-group km-hex-loot-group">
                    <label class="km-hex-links-label"><i class="fa-solid fa-coins"></i> {{localizeKM "kingdom.hexContent.loot.title"}}
                        {{#if manifestAwarded}}<span class="km-hex-loot-awarded">{{localizeKM "kingdom.hexContent.loot.awardedBadge"}}</span>{{/if}}
                    </label>
                    <div class="km-hex-loot-zone">
                        <i class="fa-solid fa-hand-pointer"></i> {{localizeKM "kingdom.hexContent.loot.dropHint"}}
                    </div>
                    <div class="km-hex-loot-list">
                        {{#each lootRows}}
                        <div class="km-hex-loot-row" data-uuid="{{this.uuid}}" data-name="{{this.name}}">
                            <span class="km-hex-loot-link">{{{this.link}}}</span>
                            <input type="number" class="km-hex-loot-qty" min="0" value="{{this.quantity}}" title="{{localizeKM 'kingdom.hexContent.loot.quantity'}}">
                            <input type="number" class="km-hex-loot-gp" min="0" step="0.01" value="{{this.gpValue}}" title="{{localizeKM 'kingdom.hexContent.loot.gpValue'}}">
                            <label class="km-hex-loot-cursed" title="{{localizeKM 'kingdom.hexContent.loot.cursed'}}">
                                <input type="checkbox" {{#if this.cursed}}checked{{/if}}> {{localizeKM "kingdom.hexContent.loot.cursedShort"}}
                            </label>
                            <input type="text" class="km-hex-loot-note" value="{{this.note}}" placeholder="{{localizeKM 'kingdom.hexContent.loot.note'}}">
                            <a class="km-hex-loot-remove" title="{{localizeKM 'kingdom.hexContent.loot.remove'}}">×</a>
                        </div>
                        {{/each}}
                    </div>
                    <div class="km-hex-loot-summary">{{lootSummary}}</div>
                </div>
                </div>
            </div>
            <div class="km-form-actions">
                <button type="button" class="km-btn km-btn-save" data-action="save">{{localizeKM "kingdom.hexContent.save"}}</button>
                <button type="button" class="km-btn" data-action="cancel-edit">{{localizeKM "kingdom.hexContent.cancel"}}</button>
            </div>
        </div>
    {{else}}
        <div class="km-hex-content-toolbar">
            <button type="button" class="km-btn km-btn-primary" data-action="add-new">{{localizeKM "kingdom.hexContent.addNew"}}</button>
        </div>
        <div class="km-hex-content-list">
            {{#if entries.length}}
                <table class="km-table">
                    <thead>
                        <tr>
                            <th>{{localizeKM "kingdom.hexContent.hexKey"}}</th>
                            <th>{{localizeKM "kingdom.hexContent.type"}}</th>
                            <th>{{localizeKM "kingdom.hexContent.name"}}</th>
                            <th>{{localizeKM "kingdom.hexContent.visibility"}}</th>
                            <th>{{localizeKM "kingdom.hexContent.links"}}</th>
                            <th>{{localizeKM "kingdom.hexContent.actions"}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each entries}}
                            <tr data-content-id="{{this.id}}">
                                <td>{{this.hexLabel}}</td>
                                <td>{{this.typeName}}</td>
                                <td>{{this.name}}</td>
                                <td>
                                    <span class="km-badge km-badge-{{this.visibility}}">{{this.visibilityName}}</span>
                                </td>
                                <td class="km-hex-links-cell">
                                    {{#if this.hasManifest}}<span class="km-hex-link-count km-hex-loot-count{{#if this.manifestAwarded}} km-hex-loot-count-awarded{{/if}}" title="{{this.lootSummary}}"><i class="fa-solid fa-coins"></i></span>{{/if}}
                                    {{#if this.hasManifest}}{{#unless this.manifestAwarded}}<button type="button" class="km-hex-award-loot" data-action="award-loot" data-content-id="{{this.id}}" title="{{localizeKM 'kingdom.hexContent.loot.awardButton'}}"><i class="fa-solid fa-gem"></i></button>{{/unless}}{{/if}}
                                    {{#if this.hasLinks}}
                                        {{#if this.linkedQuestCount}}<span class="km-hex-link-count" title="{{localizeKM 'kingdom.hexContent.linkedQuests'}}"><i class="fa-solid fa-scroll"></i> {{this.linkedQuestCount}}</span>{{/if}}
                                        {{#if this.linkedDocCount}}<span class="km-hex-link-count" title="{{localizeKM 'kingdom.hexContent.linkedDocuments'}}"><i class="fa-solid fa-link"></i> {{this.linkedDocCount}}</span>{{/if}}
                                        {{#if this.hasWarThreat}}<span class="km-hex-link-count" title="{{localizeKM 'kingdom.hexContent.linkedWarThreat'}}"><i class="fa-solid fa-skull"></i></span>{{/if}}
                                    {{else}}
                                        {{#unless this.hasManifest}}<span class="km-hex-no-links">—</span>{{/unless}}
                                    {{/if}}
                                </td>
                                <td class="km-actions">
                                    <button type="button" class="km-btn km-btn-sm" data-action="edit" data-content-id="{{this.id}}">{{localizeKM "kingdom.hexContent.edit"}}</button>
                                    {{#if (eq this.visibility "hidden")}}
                                        <button type="button" class="km-btn km-btn-sm km-btn-reveal" data-action="reveal" data-content-id="{{this.id}}">{{localizeKM "kingdom.hexContent.reveal"}}</button>
                                    {{else}}
                                        <button type="button" class="km-btn km-btn-sm" data-action="hide" data-content-id="{{this.id}}">{{localizeKM "kingdom.hexContent.hide"}}</button>
                                    {{/if}}
                                    <button type="button" class="km-btn km-btn-sm km-btn-clear" data-action="clear" data-content-id="{{this.id}}">{{localizeKM "kingdom.hexContent.clear"}}</button>
                                    <button type="button" class="km-btn km-btn-sm km-btn-danger" data-action="delete" data-content-id="{{this.id}}">{{localizeKM "kingdom.hexContent.delete"}}</button>
                                </td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            {{else}}
                <p class="km-empty">{{localizeKM "kingdom.hexContent.noContent"}}</p>
            {{/if}}
        </div>
    {{/if}}
</div>

