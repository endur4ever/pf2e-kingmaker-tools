<div class="km-hex-content-form">
    <h3>{{t "kingdom.hexContent.addToHex"}}: {{hexKey}}</h3>
    {{#each formRows}}
        {{{this}}}
    {{/each}}
    <div class="km-form-actions">
        <button type="button" class="km-btn km-btn-save" data-action="save">{{t "kingdom.hexContent.save"}}</button>
        <button type="button" class="km-btn" data-action="cancel">{{t "kingdom.hexContent.cancel"}}</button>
    </div>
</div>
