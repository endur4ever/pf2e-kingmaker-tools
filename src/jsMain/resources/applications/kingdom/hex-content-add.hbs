<div class="km-hex-content-form">
    <h3>{{localizeKM "kingdom.hexContent.addToHex"}}: {{hexKey}}</h3>
    {{#each formRows}}
        {{> formElement this}}
    {{/each}}
    <div class="km-form-actions">
        <button type="button" class="km-btn km-btn-save" data-action="save">{{localizeKM "kingdom.hexContent.save"}}</button>
        <button type="button" class="km-btn" data-action="cancel">{{localizeKM "kingdom.hexContent.cancel"}}</button>
    </div>
</div>
