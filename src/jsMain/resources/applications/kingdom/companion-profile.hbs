<div class="km-companion-profile">
    <header class="km-cp-header">
        {{#if img}}
        <div class="km-cp-portrait"><img src="{{img}}" alt="{{companionName}}" /></div>
        {{/if}}
        <div class="km-cp-heading">
            <h1>{{companionName}}</h1>
            <div class="km-cp-tags">
                <span class="km-cp-role {{#if (eq roleLabel "NPC")}}km-role-npc{{else}}km-role-companion{{/if}}">{{roleLabel}}</span>
                <span class="km-cp-discovery" data-status="{{discoveryStatus}}">{{discoveryStatusLabel}}</span>
            </div>
        </div>
    </header>

    <section class="km-cp-influence">
        <div class="km-cp-influence-label">
            <span>{{localizeKM "kingdom.companion.influence"}}</span>
            <span class="km-cp-influence-value">{{influence}} / {{maxInfluence}}</span>
        </div>
        <div class="km-cp-influence-bar">
            <div class="km-cp-influence-fill" style="width: {{influencePercent}}%"></div>
        </div>
        {{#if isGM}}
        <div class="km-cp-influence-controls">
            <button type="button" data-action="influence-decrease" title="-1"><i class="fa-solid fa-minus"></i></button>
            <button type="button" data-action="influence-increase"
                    title="{{#if influenceAttemptUsedThisSession}}{{localizeKM "kingdom.companion.influenceAttemptUsed"}}{{else}}+1{{/if}}"
                    {{#if influenceAttemptUsedThisSession}}disabled{{/if}}><i class="fa-solid fa-plus"></i></button>
            {{#if influenceAttemptUsedThisSession}}
            <button type="button" data-action="reset-influence-attempt" title="{{localizeKM "kingdom.companion.allowAnother"}}"><i class="fa-solid fa-rotate-left"></i></button>
            {{/if}}
        </div>
        {{/if}}
    </section>

    <section class="km-cp-level">
        <div class="km-cp-level-label">
            <span>{{localizeKM "kingdom.companion.level"}}</span>
            <span class="km-cp-level-value">{{level}}</span>
        </div>
        <div class="km-cp-xp-label">
            <span>{{localizeKM "kingdom.companion.xp"}}</span>
            <span class="km-cp-xp-value">{{xp}}</span>
        </div>
        <div class="km-cp-xp-bar">
            <div class="km-cp-xp-fill" style="width: {{xpPercent}}%"></div>
        </div>
    </section>

    <section class="km-cp-status-row">
        <div class="km-cp-camp">
            <label>{{localizeKM "kingdom.companion.campAvailable"}}</label>
            <span class="km-cp-badge {{#if campAvailable}}km-camp-available{{else}}km-camp-unavailable{{/if}}">
                {{#if campAvailable}}{{localizeKM "kingdom.companion.inCamp"}}{{else}}{{localizeKM "kingdom.companion.notInCamp"}}{{/if}}
            </span>
            {{#if isGM}}
            <button type="button" class="km-cp-toggle" data-action="toggle-camp-available">
                <i class="fa-solid fa-right-left"></i>
            </button>
            {{/if}}
        </div>

        <div class="km-cp-expedition-status">
            <label>{{localizeKM "kingdom.companion.expeditionStatusLabel"}}</label>
            <span class="km-cp-badge km-expedition-{{expeditionStatus}}">{{expeditionStatusLabel}}</span>
            {{#if injuryDaysRemaining}}
            <span class="km-cp-badge km-injured">{{localizeKM "kingdom.companion.injured"}} ({{injuryDaysRemaining}} {{localizeKM "kingdom.companion.days"}})</span>
            {{/if}}
        </div>

        {{#if hasCareerExpeditions}}
        <div class="km-cp-career">
            <label>{{localizeKM "kingdom.companion.careerLabel"}}</label>
            <span class="km-cp-badge">{{localizeKM "kingdom.companion.careerSummary" count=careerExpeditions triumphs=careerTriumphs scars=careerScars}}</span>
        </div>
        {{/if}}

        {{#if isGM}}
        <div class="km-cp-discovery-control">
            <label for="discoveryStatus">{{localizeKM "kingdom.companion.discoveryStatus"}}</label>
            <select name="discoveryStatus">
                {{#each discoveryStages}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
            </select>
            <button type="button" data-action="set-discovery"
                    title="{{#if discoveryAttemptUsedThisSession}}{{localizeKM "kingdom.companion.discoveryAttemptUsed"}}{{/if}}"
                    {{#if discoveryAttemptUsedThisSession}}disabled{{/if}}>{{localizeKM "applications.save"}}</button>
            {{#if discoveryAttemptUsedThisSession}}
            <button type="button" data-action="reset-discovery-attempt">{{localizeKM "kingdom.companion.allowAnother"}}</button>
            {{/if}}
        </div>
        {{/if}}
    </section>

    {{#if isGM}}
    {{#if canSendOnExpedition}}
    <section class="km-cp-expedition-action">
        <button type="button" class="km-cp-send-expedition" data-action="send-on-expedition">
            <i class="fa-solid fa-paper-plane"></i> {{localizeKM "kingdom.companion.sendOnExpedition"}}
        </button>
    </section>
    {{/if}}
    {{/if}}

    {{#if currentExpeditions.length}}
    <section class="km-cp-expeditions">
        <h2 class="km-cp-expeditions-header">{{localizeKM "kingdom.companion.currentExpeditions"}}</h2>
        <div class="km-cp-expedition-list">
            {{#each currentExpeditions}}
            <div class="km-cp-expedition-card">
                <div class="km-cp-expedition-title">
                    <span>{{this.title}}</span>
                    <span class="km-cp-badge km-tier-{{this.tier}}">{{this.tierLabel}}</span>
                </div>
                <div class="km-cp-expedition-progress">
                    <div class="km-cp-progress-bar">
                        <div class="km-cp-progress-fill" style="width: {{this.progressPercent}}%"></div>
                    </div>
                    <span class="km-cp-expedition-days">{{this.daysRemaining}} / {{this.totalDays}} {{localizeKM "kingdom.companion.days"}}</span>
                </div>
                <div class="km-cp-expedition-meta">
                    {{#if this.dc}}<span>DC {{this.dc}}</span>{{/if}}
                    <span class="km-cp-badge">{{this.statusLabel}}</span>
                </div>
            </div>
            {{/each}}
        </div>
    </section>
    {{/if}}

    {{#if pastExpeditions.length}}
    <section class="km-cp-expeditions km-cp-expeditions-past">
        <h2 class="km-cp-expeditions-header">{{localizeKM "kingdom.companion.pastExpeditions"}}</h2>
        <div class="km-cp-expedition-list">
            {{#each pastExpeditions}}
            <div class="km-cp-expedition-card km-cp-expedition-resolved">
                <div class="km-cp-expedition-title">
                    <span>{{this.title}}</span>
                    <span class="km-cp-badge">{{this.statusLabel}}</span>
                </div>
            </div>
            {{/each}}
        </div>
    </section>
    {{/if}}

    {{#if plotHook}}
    <section class="km-cp-plot-hook">
        <label>{{localizeKM "kingdom.roster.plotHook"}}</label>
        <p>{{plotHook}}</p>
    </section>
    {{/if}}

    <section class="km-cp-quests">
        <h2 class="km-cp-quests-header">
            <span><i class="fa-solid fa-scroll"></i> {{localizeKM "kingdom.companion.personalQuests"}}</span>
            {{#if isGM}}
            <button type="button" class="km-cp-add-quest" data-action="add-personal-quest">
                <i class="fa-solid fa-plus"></i> {{localizeKM "kingdom.companion.addPersonalQuest"}}
            </button>
            {{/if}}
        </h2>
        {{#if personalQuests.length}}
        <div class="km-cp-quest-list">
            {{#each personalQuests}}
            {{> companionQuestCard this}}
            {{/each}}
        </div>
        {{else}}
        <p class="km-cp-empty">{{localizeKM "kingdom.companion.noPersonalQuests"}}</p>
        {{/if}}
    </section>
</div>
