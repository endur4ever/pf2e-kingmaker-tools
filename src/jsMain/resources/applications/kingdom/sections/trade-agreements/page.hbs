<div {{#if (ne currentNavEntry 'tradeAgreements')}}hidden{{/if}} class="km-kingdom-sheet-content">
    <div class="km-kingdom-sheet-sub-content km-kingdom-sheet-trade-agreements">
        <section>
            <h2>{{localizeKM "kingdom.groups"}}  {{#if isGM}}<span class="km-header-right-align"><button type="button" data-action="add-group"><i class="fa-solid fa-plus"></i></button></span>{{/if}}</h2>
            <table>
                <thead>
                <tr>
                    <td>{{localizeKM "applications.name"}}</td>
                    <td>{{localizeKM "kingdom.negotiationDc"}}</td>
                    <td>{{localizeKM "kingdom.atWar"}}</td>
                    <td>{{localizeKM "kingdom.preventPledgeOfFealty"}}</td>
                    <td>{{localizeKM "kingdom.relations"}}</td>
                    <td>{{localizeKM "kingdom.caravans.partnerHex"}}</td>
                    <td>{{localizeKM "kingdom.attitude"}}</td>
                    <td>{{localizeKM "kingdom.treaty"}}</td>
                    <td>{{localizeKM "applications.delete"}}</td>
                </tr>
                </thead>
                <tbody>
                {{#each groups}}
                    <tr>
                        <td>{{> formElement name}}</td>
                        <td>{{> formElement negotiationDC}}</td>
                        <td>{{> formElement atWar}}</td>
                        <td>{{> formElement preventPledgeOfFealty}}</td>
                        <td>{{> formElement relations}}</td>
                        <td>{{> formElement hexKey}}</td>
                        <td>{{attitude}} ({{standing}})
                            {{#if ../isGM}}
                                <button type="button" data-action="adjust-standing" data-index="{{@index}}" data-tooltip="{{localizeKM "kingdom.adjustStanding"}}">
                                    <i class="fa-solid fa-scale-balanced"></i>
                                </button>
                            {{/if}}
                        </td>
                        <td>
                            {{#if allianceLevel}}
                                {{localizeKM (concat "kingdom.allianceLevel." allianceLevel)}}
                                {{#if (eq allianceLevel "tribute")}}
                                    {{#if ../isGM}}
                                        <button type="button" data-action="annex-group" data-index="{{@index}}" data-tooltip="{{localizeKM "kingdom.annexTooltip"}}">
                                            <i class="fa-solid fa-crown"></i>
                                        </button>
                                    {{/if}}
                                {{/if}}
                            {{/if}}
                        </td>
                        <td>{{#if ../isGM}}<button type="button" data-action="delete-group" data-index="{{@index}}">
                            <i class="fa-solid fa-trash"></i>
                        </button>{{/if}}</td>
                    </tr>
                {{else}}
                    <tr class="km-groups-empty">
                        <td colspan="9">
                            {{#if isGM}}
                                {{localizeKM "kingdom.noGroupsGm"}}
                                <button type="button" data-action="add-group"><i class="fa-solid fa-plus"></i> {{localizeKM "kingdom.addGroup"}}</button>
                            {{else}}
                                {{localizeKM "kingdom.noGroupsPlayer"}}
                            {{/if}}
                        </td>
                    </tr>
                {{/each}}
                </tbody>
            </table>
        </section>
        {{> kingdom-rival-charter this}}
        <section>
            <h2>{{localizeKM "kingdom.factionAgenda.title"}}</h2>
            <ul class="km-agenda-cards">
                {{#each groups}}
                    {{#if this.agenda}}
                        <li class="km-agenda-card">
                            <b>{{this.plainName}}</b> — {{this.agenda.goalLabel}}
                            <span class="km-sub-points">{{this.agenda.progress}}/{{this.agenda.segments}}</span>
                            {{#if this.agenda.archetypeLabel}}<span class="km-agenda-archetype">{{this.agenda.archetypeLabel}}</span>{{/if}}
                            <div class="km-sub-bar"><span class="km-sub-bar__fill" style="width: {{this.agenda.progressPct}}%"></span></div>
                            {{#if this.agenda.cooldownSummary}}<p class="km-sub-note">{{this.agenda.cooldownSummary}}</p>{{/if}}
                            {{#if ../isGM}}
                                <span class="km-sub-controls">
                                    <button type="button" data-action="edit-faction-agenda" data-index="{{@index}}" data-tooltip="{{localizeKM "kingdom.factionAgenda.edit"}}"><i class="fa-solid fa-sliders"></i></button>
                                    <button type="button" data-action="clear-faction-agenda" data-index="{{@index}}" data-tooltip="{{localizeKM "kingdom.factionAgenda.clear"}}"><i class="fa-solid fa-broom"></i></button>
                                </span>
                            {{/if}}
                        </li>
                    {{else}}
                        {{#if ../isGM}}
                            <li class="km-agenda-card km-agenda-card--idle">
                                <b>{{this.plainName}}</b>
                                <button type="button" data-action="edit-faction-agenda" data-index="{{@index}}"><i class="fa-solid fa-plus"></i> {{localizeKM "kingdom.factionAgenda.assign"}}</button>
                            </li>
                        {{/if}}
                    {{/if}}
                {{/each}}
            </ul>
        </section>
        <section>
            <h2>{{localizeKM "kingdom.standingLog"}}</h2>
            {{#each groups}}
                {{#if standingLog.length}}
                    <details>
                        <summary>{{name.value}}</summary>
                        <table>
                            <thead>
                            <tr>
                                <td>{{localizeKM "kingdom.turnNumber"}}</td>
                                <td>{{localizeKM "kingdom.standingDelta"}}</td>
                                <td>{{localizeKM "kingdom.standingReason"}}</td>
                            </tr>
                            </thead>
                            <tbody>
                            {{#each standingLog}}
                            <tr>
                                <td>{{turn}}</td>
                                <td>{{delta}}</td>
                                <td>{{localizeKM reason}}</td>
                            </tr>
                            {{/each}}
                            </tbody>
                        </table>
                    </details>
                {{/if}}
            {{/each}}
        </section>
        <section>
            <h2>{{localizeKM "kingdom.rivalRealms.title"}}
                {{#if isGM}}<span class="km-header-right-align"><button type="button" data-action="add-rival-realm"><i class="fa-solid fa-plus"></i></button></span>{{/if}}
            </h2>
            {{#if rivalRealms.hasRivals}}
                <table>
                    <thead>
                    <tr>
                        <td>{{localizeKM "kingdom.rivalRealms.rank"}}</td>
                        <td>{{localizeKM "kingdom.rivalRealms.realm"}}</td>
                        <td>{{localizeKM "kingdom.rivalRealms.power"}}</td>
                        <td>{{localizeKM "kingdom.rivalRealms.size"}}</td>
                        <td>{{localizeKM "kingdom.rivalRealms.fame"}}</td>
                        <td>{{localizeKM "kingdom.rivalRealms.armies"}}</td>
                        {{#if isGM}}
                            <td>{{localizeKM "kingdom.rivalRealms.growth"}}</td>
                            <td></td>
                        {{/if}}
                    </tr>
                    </thead>
                    <tbody>
                    {{#each rivalRealms.rows}}
                        <tr class="{{#if isPlayer}}km-rival-player-row{{/if}}">
                            <td>#{{rank}}</td>
                            <td>{{label}}{{#unless linked}} <i class="fa-solid fa-link-slash" data-tooltip="{{localizeKM "kingdom.rivalRealms.unlinked"}}"></i>{{/unless}}</td>
                            <td>{{score}}</td>
                            <td>{{size}}</td>
                            <td>{{fame}}</td>
                            <td>{{armyCount}}</td>
                            {{#if ../isGM}}
                                <td>{{#unless isPlayer}}{{growthSummary}}{{/unless}}</td>
                                <td>{{#unless isPlayer}}
                                    <button type="button" data-action="edit-rival-realm" data-id="{{id}}"><i class="fa-solid fa-sliders"></i></button>
                                    <button type="button" data-action="delete-rival-realm" data-id="{{id}}"><i class="fa-solid fa-trash"></i></button>
                                {{/unless}}</td>
                            {{/if}}
                        </tr>
                    {{/each}}
                    </tbody>
                </table>
            {{else}}
                <p>{{localizeKM "kingdom.rivalRealms.empty"}}</p>
            {{/if}}
        </section>
    </div>
</div>
