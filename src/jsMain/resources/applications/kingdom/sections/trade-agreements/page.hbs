<div {{#if (ne currentNavEntry 'tradeAgreements')}}hidden{{/if}} class="km-kingdom-sheet-content">
    <div class="km-kingdom-sheet-sub-content km-kingdom-sheet-trade-agreements">
        <section>
            <h2>{{localizeKM "kingdom.groups"}}  {{#if isGM}}<span class="km-header-right-align"><button type="button" data-action="add-group"><i class="fa-solid fa-plus"></i></button></span>{{/if}}</h2>
            <table>
                <thead>
                <tr>
                    <td>{{localizeKM "applications.name"}}</td>
                    <td>{{localizeKM "kingdom.negotiationDc"}}</td>
                    <td>{{localizeKM "kingdom.atWar"}}</td>
                    <td>{{localizeKM "kingdom.preventPledgeOfFealty"}}</td>
                    <td>{{localizeKM "kingdom.relations"}}</td>
                    <td>{{localizeKM "kingdom.caravans.partnerHex"}}</td>
                    <td>{{localizeKM "kingdom.attitude"}}</td>
                    <td>{{localizeKM "kingdom.treaty"}}</td>
                    <td>{{localizeKM "applications.delete"}}</td>
                </tr>
                </thead>
                <tbody>
                {{#each groups}}
                    <tr>
                        <td>{{> formElement name}}</td>
                        <td>{{> formElement negotiationDC}}</td>
                        <td>{{> formElement atWar}}</td>
                        <td>{{> formElement preventPledgeOfFealty}}</td>
                        <td>{{> formElement relations}}</td>
                        <td>{{> formElement hexKey}}</td>
                        <td>{{attitude}} ({{standing}})
                            {{#if ../isGM}}
                                <button type="button" data-action="adjust-standing" data-index="{{@index}}" data-tooltip="{{localizeKM "kingdom.adjustStanding"}}">
                                    <i class="fa-solid fa-scale-balanced"></i>
                                </button>
                            {{/if}}
                        </td>
                        <td>
                            {{#if allianceLevel}}
                                {{localizeKM (concat "kingdom.allianceLevel." allianceLevel)}}
                                {{#if (eq allianceLevel "tribute")}}
                                    {{#if ../isGM}}
                                        <button type="button" data-action="annex-group" data-index="{{@index}}" data-tooltip="{{localizeKM "kingdom.annexTooltip"}}">
                                            <i class="fa-solid fa-crown"></i>
                                        </button>
                                    {{/if}}
                                {{/if}}
                            {{/if}}
                        </td>
                        <td>{{#if ../isGM}}<button type="button" data-action="delete-group" data-index="{{@index}}">
                            <i class="fa-solid fa-trash"></i>
                        </button>{{/if}}</td>
                    </tr>
                {{else}}
                    <tr class="km-groups-empty">
                        <td colspan="9">
                            {{#if isGM}}
                                {{localizeKM "kingdom.noGroupsGm"}}
                                <button type="button" data-action="add-group"><i class="fa-solid fa-plus"></i> {{localizeKM "kingdom.addGroup"}}</button>
                            {{else}}
                                {{localizeKM "kingdom.noGroupsPlayer"}}
                            {{/if}}
                        </td>
                    </tr>
                {{/each}}
                </tbody>
            </table>
        </section>
        <section>
            <h2>{{localizeKM "kingdom.standingLog"}}</h2>
            {{#each groups}}
                {{#if standingLog.length}}
                    <details>
                        <summary>{{name.value}}</summary>
                        <table>
                            <thead>
                            <tr>
                                <td>{{localizeKM "kingdom.turnNumber"}}</td>
                                <td>{{localizeKM "kingdom.standingDelta"}}</td>
                                <td>{{localizeKM "kingdom.standingReason"}}</td>
                            </tr>
                            </thead>
                            <tbody>
                            {{#each standingLog}}
                            <tr>
                                <td>{{turn}}</td>
                                <td>{{delta}}</td>
                                <td>{{localizeKM reason}}</td>
                            </tr>
                            {{/each}}
                            </tbody>
                        </table>
                    </details>
                {{/if}}
            {{/each}}
        </section>
    </div>
</div>
