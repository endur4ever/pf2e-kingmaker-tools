<aside class="km-kingdom-sheet-sidebar km-kingdom-sheet-sidebar-turn" {{#if (ne currentNavEntry 'turn')}}hidden{{/if}}>
    <div {{#if (ne currentNavEntry 'turn')}}hidden{{/if}}>
        <h3>{{localizeKM "kingdom.status"}}</h3>
        {{> formElement settlementInput }}
        <div class="km-sidebar-spacer"></div>
        {{> formElement activeLeader}}
        <div class="km-sidebar-spacer"></div>
        {{> formElement atWarInput }}
        <h3>{{localizeKM "kingdom.vacancies"}}</h3>
        <p>{{localizeKM "kingdom.vacanciesHelp"}}</p>
        {{#each leadersContext}}
            {{> formElement vacant }}
        {{/each}}
        {{#useLeadershipModifiers}}
            <div class="km-leadership-modifier-info">
                <button type="button" data-action="inspect-leader-skills">{{localizeKM
                        "kingdom.characterSkills"}}</button>
                <button type="button" data-action="inspect-kingdom-skills">{{localizeKM
                        "kingdom.kingdomSkills"}}</button>
            </div>
        {{/useLeadershipModifiers}}
        <h3>{{localizeKM "kingdom.unrest"}}</h3>
        <table class="km-unrest">
            <tr>
                <td>{{> formElement unrestInput }}</td>
                <td>/</td>
                <td title="{{localizeKM "kingdom.threshold"}}">{{anarchyAt}}</td>
                <td>=</td>
                <td title="{{localizeKM "kingdom.penalty"}}">{{ unrestPenalty}}</td>
            </tr>
        </table>
        <h3>{{localizeKM "kingdom.ruin"}}</h3>
        <table class="km-unrest-ruin">
            {{#each ruinContext}}
                <tr>
                    <td>{{> formElement value }}</td>
                    <td>/</td>
                    <td title="{{localizeKM "kingdom.threshold"}}">{{> formElement threshold }}{{#if ../automateStats}}
                        <div class="km-threshold-value">{{thresholdValue}}</div>{{/if}}</td>
                    <td>=</td>
                    <td title="{{localizeKM "kingdom.penalty"}}">{{> formElement penalty }}</td>
                </tr>
            {{/each}}
        </table>
        <h3>{{localizeKM "applications.skills"}} ({{localizeKM "kingdom.controlDc"}}: {{controlDc}})</h3>
        {{#if (eq currentNavEntry 'turn')}}
            <table class="km-skill-checks">
                {{#each skillChecks}}
                    <tr>
                        <td class="km-skills-label" title="{{label}}">{{label}}</td>
                        <td>{{> formElement input }}{{#if ../automateStats}}
                            <span class="km-proficiency km-proficiency-value {{valueClass}}">{{proficiency}}</span>{{/if}}
                        </td>
                        <td>
                            <button type="button" data-action="roll-skill-check" data-skill="{{skill}}">{{modifier}} <i
                                    class="fa-solid fa-dice-d20"></i></button>
                        </td>
                    </tr>
                {{/each}}
            </table>
        {{/if}}
        <h3>{{localizeKM "kingdom.resources"}}</h3>
        <table class="km-unrest-ruin">
            <tr>
                <th>{{localizeKM "resourceButton.turnShort.now"}}</th>
                <th>{{localizeKM "resourceButton.turnShort.next"}}</th>
            </tr>
            <tr>
                <td>{{> formElement resourceDiceContext.now }}</td>
                <td>{{> formElement resourceDiceContext.next }}</td>
            </tr>
            <tr>
                <td>{{> formElement resourcePointsContext.now }}</td>
                <td>{{> formElement resourcePointsContext.next }}</td>
            </tr>
        </table>
        {{#if decadentFeastsShieldActive}}
            <p class="km-unrest-shield"><i class="fa-solid fa-shield-heart"></i> {{localizeKM "kingdom.decadentFeasts.shieldActive"}}</p>
        {{/if}}
        {{#if bankedBonusesContext.length}}
            <fieldset class="km-banked-aid">
                <legend>{{localizeKM "kingdom.bankedAid.title"}}</legend>
                <ul class="km-banked-aid-list">
                    {{#each bankedBonusesContext}}
                        <li{{#if this.expired}} class="km-banked-aid-expired"{{/if}}>
                            <strong>+{{this.value}}</strong> {{this.source}}
                            <span class="km-banked-aid-expiry">{{localizeKM "kingdom.bankedAid.expiry"}}: {{this.expiry}}</span>
                        </li>
                    {{/each}}
                </ul>
                <p class="km-banked-aid-help">{{localizeKM "kingdom.bankedAid.help"}}</p>
            </fieldset>
        {{/if}}
        {{#if isGM}}
            <div class="km-bonus-resource-dice">
                <label>{{localizeKM "kingdom.bonusResourceDice"}}</label>
                {{> formElement bonusResourceDiceInput }}
            </div>
        {{/if}}
        <h3>{{localizeKM "kingdom.commodities"}}</h3>
        <table class="km-unrest-ruin">
            <tr>
                <th>{{localizeKM "resourceButton.turnShort.now"}}</th>
                <th class="km-slash-header"></th>
                <th></th>
                <th class="km-next-header" title="{{localizeKM "resourceButton.turnShort.next"}}">{{localizeKM
                        "resourceButton.turnShort.next"}}</th>
            </tr>
            <tr>
                <td>{{> formElement commoditiesContext.now.food }}</td>
                <td>/</td>
                <td class="km-capacity">{{ commoditiesContext.capacity.food }}</td>
                <td>{{> formElement commoditiesContext.next.food }}</td>
            </tr>
            <tr>
                <td>{{> formElement commoditiesContext.now.lumber }}</td>
                <td>/</td>
                <td class="km-capacity">{{ commoditiesContext.capacity.lumber }}</td>
                <td>
                    {{> formElement commoditiesContext.next.lumber }}
                    {{#if commoditiesContext.cappedByStorage.lumber}}
                        <i class="fa-solid fa-boxes-stacked km-storage-cap-hint" title="{{localizeKM "kingdom.turn.cappedByStorage"}}"></i>
                    {{/if}}
                </td>
            </tr>
            <tr>
                <td>{{> formElement commoditiesContext.now.stone }}</td>
                <td>/</td>
                <td class="km-capacity">{{ commoditiesContext.capacity.stone }}</td>
                <td>
                    {{> formElement commoditiesContext.next.stone }}
                    {{#if commoditiesContext.cappedByStorage.stone}}
                        <i class="fa-solid fa-boxes-stacked km-storage-cap-hint" title="{{localizeKM "kingdom.turn.cappedByStorage"}}"></i>
                    {{/if}}
                </td>
            </tr>
            <tr>
                <td>{{> formElement commoditiesContext.now.ore }}</td>
                <td>/</td>
                <td class="km-capacity">{{ commoditiesContext.capacity.ore }}</td>
                <td>
                    {{> formElement commoditiesContext.next.ore }}
                    {{#if commoditiesContext.cappedByStorage.ore}}
                        <i class="fa-solid fa-boxes-stacked km-storage-cap-hint" title="{{localizeKM "kingdom.turn.cappedByStorage"}}"></i>
                    {{/if}}
                </td>
            </tr>
            <tr>
                <td>{{> formElement commoditiesContext.now.luxuries }}</td>
                <td>/</td>
                <td class="km-capacity">{{ commoditiesContext.capacity.luxuries }}</td>
                <td>
                    {{> formElement commoditiesContext.next.luxuries }}
                    {{#if commoditiesContext.cappedByStorage.luxuries}}
                        <i class="fa-solid fa-boxes-stacked km-storage-cap-hint" title="{{localizeKM "kingdom.turn.cappedByStorage"}}"></i>
                    {{/if}}
                </td>
            </tr>
        </table>
        <h3>{{localizeKM "kingdom.solutions"}}</h3>
        {{> formElement supernaturalSolutionsInput }}
        {{> formElement creativeSolutionsInput }}
        {{#if enableCouncilMissions}}
            <h3>{{localizeKM "kingdom.councilMissions.title"}}</h3>
            <div class="km-council-missions">
                <div class="km-mission-item">
                    <button type="button" data-action="council-mission-audit" {{#unless canAudit}}disabled{{/unless}}>
                        {{localizeKM "kingdom.councilMissions.audit.btn"}}
                    </button>
                    <div class="km-mission-info">
                        {{#if (gt auditCooldownTurns 0)}}
                            <span class="km-cooldown">{{localizeKM "kingdom.councilMissions.cooldown" turns=auditCooldownTurns}}</span>
                        {{else if canAudit}}
                            <span class="km-ready">{{localizeKM "kingdom.councilMissions.ready"}}</span>
                        {{else}}
                            <span class="km-cooldown">{{localizeKM "kingdom.councilMissions.unavailable"}}</span>
                        {{/if}}
                    </div>
                    <div class="km-tooltip">
                        <div class="km-tooltip-title">{{localizeKM "kingdom.councilMissions.audit.btn"}}</div>
                        <div class="km-tooltip-desc">{{localizeKM "kingdom.councilMissions.audit.help"}}</div>
                    </div>
                </div>
                <div class="km-mission-item">
                    <button type="button" data-action="council-mission-scrying" {{#unless canScrying}}disabled{{/unless}}>
                        {{localizeKM "kingdom.councilMissions.scrying.btn"}}
                    </button>
                    <div class="km-mission-info">
                        {{#if (gt scryingCooldownTurns 0)}}
                            <span class="km-cooldown">{{localizeKM "kingdom.councilMissions.cooldown" turns=scryingCooldownTurns}}</span>
                        {{else if canScrying}}
                            <span class="km-ready">{{localizeKM "kingdom.councilMissions.ready"}}</span>
                        {{else}}
                            <span class="km-cooldown">{{localizeKM "kingdom.councilMissions.unavailable"}}</span>
                        {{/if}}
                    </div>
                    <div class="km-tooltip">
                        <div class="km-tooltip-title">{{localizeKM "kingdom.councilMissions.scrying.btn"}}</div>
                        <div class="km-tooltip-desc">{{localizeKM "kingdom.councilMissions.scrying.help"}}</div>
                    </div>
                </div>
                <div class="km-mission-item">
                    <button type="button" data-action="council-mission-lockdown" {{#unless canLockdown}}disabled{{/unless}}>
                        {{localizeKM "kingdom.councilMissions.lockdown.btn"}}
                    </button>
                    <div class="km-mission-info">
                        {{#if (gt lockdownCooldownTurns 0)}}
                            <span class="km-cooldown">{{localizeKM "kingdom.councilMissions.cooldown" turns=lockdownCooldownTurns}}</span>
                        {{else if canLockdown}}
                            <span class="km-ready">{{localizeKM "kingdom.councilMissions.ready"}}</span>
                        {{else}}
                            <span class="km-cooldown">{{localizeKM "kingdom.councilMissions.unavailable"}}</span>
                        {{/if}}
                    </div>
                    <div class="km-tooltip">
                        <div class="km-tooltip-title">{{localizeKM "kingdom.councilMissions.lockdown.btn"}}</div>
                        <div class="km-tooltip-desc">{{localizeKM "kingdom.councilMissions.lockdown.help"}}</div>
                    </div>
                </div>
                <div class="km-mission-item">
                    <button type="button" data-action="council-mission-feast" {{#unless canFeast}}disabled{{/unless}}>
                        {{localizeKM "kingdom.councilMissions.feast.btn"}}
                    </button>
                    <div class="km-mission-info">
                        {{#if (gt feastCooldownTurns 0)}}
                            <span class="km-cooldown">{{localizeKM "kingdom.councilMissions.cooldown" turns=feastCooldownTurns}}</span>
                        {{else if canFeast}}
                            <span class="km-ready">{{localizeKM "kingdom.councilMissions.ready"}}</span>
                        {{else}}
                            <span class="km-cooldown">{{localizeKM "kingdom.councilMissions.unavailable"}}</span>
                        {{/if}}
                    </div>
                    <div class="km-tooltip">
                        <div class="km-tooltip-title">{{localizeKM "kingdom.councilMissions.feast.btn"}}</div>
                        <div class="km-tooltip-desc">{{localizeKM "kingdom.councilMissions.feast.help"}}</div>
                    </div>
                </div>
            </div>
        {{/if}}
    </div>
</aside>
<div class="km-kingdom-sheet-content" {{#if (ne currentNavEntry 'turn')}}hidden{{/if}}>
    <nav class="km-kingdom-sheet-sub-nav">
        <ul class="km-grow-subnav">
            {{#each turnSectionNav}}
                <li><a title="{{title}}"
                       {{#if active}}class="active"{{/if}} href="#" data-id="{{../actorUuid}}-km-turn-{{link}}"
                       data-action="{{action}}">{{label}}</a></li>
            {{/each}}
        </ul>
    </nav>
    <div class="km-kingdom-sheet-sub-content km-kingdom-sheet-turn">
        <section class="km-kingdom-sheet-section">
            <h2 id="{{actorUuid}}-km-turn-upkeep">{{localizeKM "kingdom.upkeep"}}</h2>
            <p>{{localizeKM "kingdom.firstTurnNotice"}}</p>
            <div class="km-upkeep-button">1) {{localizeKM "kingdom.gain1Fame"}}
                <button type="button" data-action="gain-fame">{{localizeKM "kingdom.perform"}}</button>
            </div>
            {{> kingdom-activities activities=activities.upkeep}}
            <div class="km-upkeep-button">3) {{localizeKM "kingdom.adjustUnrest"}}
                <button type="button" data-action="adjust-unrest">{{localizeKM "kingdom.perform"}}</button>
            </div>
            <div class="km-upkeep-button">4) {{localizeKM "kingdom.collectResources" diceFormula=resourceDiceIncome}}
                <button type="button" data-action="collect-resources">{{localizeKM "kingdom.perform"}}</button>
            </div>
            <div class="km-upkeep-button">5) {{localizeKM "kingdom.payConsumption"}} ({{consumption}})
                <button type="button" data-action="pay-consumption">{{localizeKM "kingdom.perform"}}</button>
            </div>
        </section>
        <section class="km-kingdom-sheet-section">
            <h2 id="{{actorUuid}}-km-turn-commerce" {{#unless activities.commerce}}hidden{{/unless}}>{{localizeKM
                    "kingdom.commerce"}} ({{localizeKM "kingdom.activitiesRemaining" remaining=activities.commerceRemaining max=activities.commerceCap}})</h2>
            {{> kingdom-activities activities=activities.commerce collectTaxesReduceUnrestDisabled=collectTaxesReduceUnrestDisabled}}
        </section>
        <section class="km-kingdom-sheet-section">
            <h2 id="{{actorUuid}}-km-turn-leadership" {{#unless activities.leadership}}hidden{{/unless}}>{{localizeKM
                    "kingdom.leadership" count=leadershipActivities}} ({{localizeKM "kingdom.activitiesRemaining" remaining=activities.leadershipRemaining max=activities.leadershipCap}})</h2>
            {{> kingdom-activities activities=activities.leadership}}
        </section>
        <section class="km-kingdom-sheet-section">
            <h2 id="{{actorUuid}}-km-turn-region" {{#unless activities.region}}hidden{{/unless}}>{{localizeKM
                    "kingdom.region"}} ({{localizeKM "kingdom.activitiesRemaining" remaining=activities.regionRemaining max=activities.regionCap}})</h2>

            {{#if heartlandLabel}}
                <p>{{localizeKM "kingdom.favoredLand" heartland=heartlandLabel}}</p>
            {{/if}}

            <p>{{localizeKM "kingdom.terrainFeature"}}</p>
            <p>{{localizeKM "kingdom.clickToClaim"}}:</p>

            <div class="km-turn-buttons">
                <button type="button" data-action="claimed-refuge">{{localizeKM "kingdom.claimedRefuge"}}</button>
                <button type="button" data-action="claimed-landmark">{{localizeKM "kingdom.claimedLandmark"}}</button>
                {{#if isGM}}
                    <button type="button" data-action="open-hex-content-manager"><i class="fa-solid fa-map-location-dot"></i> {{localizeKM "kingdom.hexContent.managerTitle"}}</button>
                {{/if}}
            </div>
            {{> kingdom-activities activities=activities.region}}
        </section>
        <section class="km-kingdom-sheet-section">
            <h2 id="{{actorUuid}}-km-turn-civic" {{#unless activities.civic}}hidden{{/unless}}>{{localizeKM
                    "kingdom.civic"}} ({{localizeKM "kingdom.activitiesRemaining" remaining=activities.civicRemaining max=activities.civicCap}})</h2>
            {{#if civicPlanning}}
                <p>{{localizeKM "kingdom.civicPlanning"}}</p>
            {{/if}}
            <p>{{localizeKM "kingdom.civicHelp"}}</p>
            {{> kingdom-activities activities=activities.civic}}
        </section>
        <section class="km-kingdom-sheet-section">
            <h2 id="{{actorUuid}}-km-turn-army" {{#unless activities.army}}hidden{{/unless}}>{{localizeKM
                    "kingdom.armyPhaseTitle"}} ({{localizeKM "kingdom.activitiesRemaining" remaining=activities.armyRemaining max=activities.armyCap}})</h2>
            <p>{{localizeKM "kingdom.armyHelp"}}</p>
            {{> kingdom-activities activities=activities.army}}
        </section>
        <section class="km-kingdom-sheet-section">
            <h2 id="{{actorUuid}}-km-turn-event">{{localizeKM "kingdom.event"}}</h2>
            <p class="km-turn-buttons">
                <button type="button" data-action="open-subsystem-trackers"><i class="fa-solid fa-diagram-project"></i> {{localizeKM "subsystems.openTrackers"}}</button>
            </p>
            {{#if isGM}}
                <p {{#unless cultOfTheBloomEvents}}hidden{{/unless}}>{{localizeKM "kingdom.cultHelp"}}</p>
                <p class="km-turn-buttons" {{#unless cultOfTheBloomEvents}}hidden{{/unless}}>
                    <button type="button" data-action="check-cult-event">{{localizeKM "kingdom.checkCultEvent"
                                                                                      dc=cultEventDC}}</button>
                    <button type="button" data-action="roll-cult-event">{{localizeKM "kingdom.rollCultEvent"}}</button>
                </p>
                <hr>
                <p class="km-turn-buttons">
                    <button type="button" data-action="check-event">{{localizeKM "kingdom.checkKingdomEvent"
                                                                                 dc=eventDC}}</button>
                    <button type="button" data-action="roll-event">{{localizeKM "kingdom.rollKingdomEvent"}}</button>
                </p>
            {{/if}}
            <h3>{{localizeKM "kingdom.activeEvents"}} <span class="km-header-right-align"
                                                            {{#unless isGM}}hidden{{/unless}}><button type="button"
                                                                                                      data-action="add-event">{{localizeKM
                    "kingdom.addEvent"}}</button></span></h3>
            <p>{{localizeKM "kingdom.continuousTraitHelp"}}</p>
            {{> kingdom-events ongoingEvents=ongoingEvents isGM=isGM}}
        </section>
        <section class="km-kingdom-sheet-section" {{#unless questTimerChanges.length}}hidden{{/unless}}>
            <h2>{{localizeKM "kingdom.questGenerator.title"}}</h2>
            {{#each questTimerChanges}}
            <div class="km-quest-timer-change">
                <span class="km-quest-timer-name">{{questName}}</span>:
                <span class="km-quest-timer-value">{{changeLabel}}</span>
            </div>
            {{/each}}
        </section>
        <section class="km-kingdom-sheet-section" {{#if (ne currentNavEntry 'clock')}}hidden{{/if}}>
            <h2 id="{{actorUuid}}-km-turn-clock">{{localizeKM "kingdom.clocks.title"}}</h2>
            {{#if campaignClocks.hasActiveClocks}}
                <p class="km-clock-summary">
                    🕐 {{localizeKM "kingdom.clocks.summary" active=campaignClocks.activeClockCount expiring=campaignClocks.expiringClockCount}}
                </p>
            {{/if}}
            {{#if isGM}}
                <p class="km-turn-buttons">
                    <button type="button" data-action="open-clock-dialog">{{localizeKM "kingdom.clocks.manage"}}</button>
                </p>
            {{/if}}
            {{#if campaignClocks.campaignClocks.length}}
                {{#each campaignClocks.campaignClocks}}
                    <div class="km-clock-card {{#if isExpired}}km-clock-expired{{/if}}">
                        <div class="km-clock-header">
                            <span class="km-clock-label">{{label}}</span>
                            {{#if active}}
                                <span class="km-clock-remaining">{{remainingTurns}}/{{maxTurns}}</span>
                            {{else}}
                                <span class="km-clock-inactive">Inactive</span>
                            {{/if}}
                        </div>
                        <div class="km-clock-progress-bar">
                            <div class="km-clock-progress-fill
                                        {{#if isExpiring}}km-clock-urgent{{/if}}
                                        {{#if isExpired}}km-clock-expired-fill{{/if}}"
                                 style="width: {{progressPercent}}%;">
                            </div>
                        </div>
                        {{#if isExpiring}}
                            <p class="km-clock-warning">{{localizeKM "kingdom.clocks.expiring"}}</p>
                        {{/if}}
                        {{#if isExpired}}
                            <p class="km-clock-warning">
                                {{#if paused}}
                                    {{localizeKM "kingdom.clocks.paused"}}
                                {{else}}
                                    {{localizeKM "kingdom.clocks.expired"}}
                                {{/if}}
                            </p>
                        {{/if}}
                    </div>
                {{/each}}
            {{else}}
                <p>{{localizeKM "kingdom.clocks.noClocks"}}</p>
            {{/if}}
        </section>
        <section class="km-kingdom-sheet-section">
            <h2 id="{{actorUuid}}-km-turn-xp">{{localizeKM "applications.xp"}}</h2>
            <p>{{localizeKM "kingdom.resolvedEventXp"}}:</p>
            <p class="km-turn-buttons">
                <button type="button" data-action="gain-xp" data-xp="10">-4</button>
                <button type="button" data-action="gain-xp" data-xp="15">-3</button>
                <button type="button" data-action="gain-xp" data-xp="20">-2</button>
                <button type="button" data-action="gain-xp" data-xp="30">-1</button>
                <button type="button" data-action="gain-xp" data-xp="40">0</button>
                <button type="button" data-action="gain-xp" data-xp="60">+1</button>
                <button type="button" data-action="gain-xp" data-xp="80">+2</button>
                <button type="button" data-action="gain-xp" data-xp="120">+3</button>
                <button type="button" data-action="gain-xp" data-xp="160">+4</button>
            </p>
            <hr>
            <p>{{localizeKM "kingdom.claimedHexXp"}}:</p>
            <p class="km-turn-buttons">
                <button type="button" data-action="hex-xp" data-hexes="1">{{localizeKM "kingdom.hex" count=1}}</button>
                <button type="button" data-action="hex-xp" data-hexes="2">{{localizeKM "kingdom.hex" count=2}}</button>
                <button type="button" data-action="hex-xp" data-hexes="3">{{localizeKM "kingdom.hex" count=3}}</button>
            </p>
            <hr>
            {{#if vkXp}}
                <p>{{localizeKM "kingdom.constructedTerrainOrStructure"}}:</p>
                <p class="km-turn-buttons">
                    <button type="button" data-action="gain-xp" data-xp="10">{{localizeKM
                            "kingdom.farmOrWorksite"}}</button>
                    <button type="button" data-action="gain-xp" data-xp="5">{{localizeKM
                            "kingdom.bridgeOrRoad"}}</button>
                    <button type="button" data-action="structure-xp">{{localizeKM "kingdom.structure"}}</button>
                </p>
                <hr>
            {{/if}}
            <p>{{localizeKM "kingdom.unusedResources"}}:</p>
            <p class="km-turn-buttons">
                <button type="button" data-action="solution-xp">{{localizeKM
                        "kingdom.creativeOrSupernaturalSolution"}}</button>
                <button type="button" data-action="rp-xp">{{localizeKM "kingdom.resourcePoints"}}</button>
            </p>
            <hr>
            <table>
                <tr>
                    <thead>
                    <th>{{localizeKM "applications.xp"}}</th>
                    <th>{{localizeKM "kingdom.milestone"}}</th>
                    </thead>
                </tr>
                {{#each milestones}}
                    <tr {{#if hidden}}hidden{{/if}}>
                        <td>{{xp}}</td>
                        <td>{{> formElement completed }}{{> formElement id }}{{> formElement enabled }}</td>
                    </tr>
                {{/each}}
            </table>
        </section>
        <section class="km-kingdom-sheet-section">
            <h2>{{localizeKM "kingdom.caravans.title"}}</h2>
            {{#if isGM}}
            <p class="km-turn-buttons">
                <button type="button" data-action="dispatch-caravan"><i class="fa-solid fa-truck-fast"></i> {{localizeKM "kingdom.caravans.dispatch"}}</button>
                <button type="button" data-action="dispatch-shipment"><i class="fa-solid fa-box-open"></i> {{localizeKM "kingdom.caravans.dispatchShipment"}}</button>
            </p>
            {{/if}}
            {{#if caravans.length}}
                <ul class="km-caravans">
                    {{#each caravans}}
                        <li class="km-caravan">
                            <span class="km-caravan-partner" title="{{summary}}">{{partner}}</span>
                            <span class="km-caravan-cargo">{{cargo}}</span>
                            <span class="km-caravan-raid">{{#if raidDc}}{{localizeKM "kingdom.caravans.raidDc" dc=raidDc}}{{/if}}</span>
                            <span class="km-caravan-eta">{{localizeKM "kingdom.caravans.etaOf" turns=turnsRemaining total=etaTurns}}</span>
                            <span class="km-caravan-actions">
                                {{#if recallable}}{{#if @root.isGM}}
                                    <button type="button" class="km-btn-sm" data-action="recall-caravan" data-caravan-id="{{id}}">{{localizeKM "kingdom.caravans.recall"}}</button>
                                {{/if}}{{/if}}
                            </span>
                        </li>
                    {{/each}}
                </ul>
            {{/if}}
            {{!-- Delivery history. This file is a REGISTERED PARTIAL, and a partial gets no
                  parent frame, so any outer-scope value reached from inside an each block must use
                  @root. Nothing in this block needs one, and it should stay that way. --}}
            <details class="km-shipment-history">
                <summary>
                    {{localizeKM "kingdom.shipmentHistory.title"}}
                    <span class="km-badge km-badge-delivered">{{shipmentHistoryDelivered}}</span>
                    <span class="km-badge km-badge-raided">{{shipmentHistoryRaided}}</span>
                    <span class="km-badge km-badge-recalled">{{shipmentHistoryRecalled}}</span>
                </summary>
                {{#if shipmentHistory.length}}
                    <ul class="km-shipment-history-list">
                        {{#each shipmentHistory}}
                            <li class="km-shipment-history-row km-shipment-{{outcome}}">
                                <span class="km-shipment-turn">{{localizeKM "kingdom.shipmentHistory.turn"}} {{turn}}</span>
                                <span class="km-shipment-outcome">{{outcomeLabel}}</span>
                                <span class="km-shipment-partner">{{partner}}</span>
                                <span class="km-shipment-cargo">{{cargo}}</span>
                                <span class="km-shipment-rd">{{rd}}</span>
                            </li>
                        {{/each}}
                    </ul>
                {{else}}
                    <p class="km-shipment-history-empty">{{localizeKM "kingdom.shipmentHistory.empty"}}</p>
                {{/if}}
            </details>
            {{#if shipments.length}}
                <h3 style="margin-top: 10px; font-size: 1.1em; opacity: 0.9;">{{localizeKM "kingdom.caravans.equipmentShipments"}}</h3>
                <ul class="km-caravans">
                    {{#each shipments}}
                        <li class="km-caravan">
                            <span class="km-caravan-partner" title="{{summary}}">{{partner}}</span>
                            <span class="km-caravan-cargo">{{cargo}}</span>
                            <span class="km-caravan-raid">{{#if raidDc}}{{localizeKM "kingdom.caravans.raidDc" dc=raidDc}}{{/if}}</span>
                            <span class="km-caravan-eta">{{localizeKM "kingdom.caravans.etaOf" turns=turnsRemaining total=etaTurns}}</span>
                            <span class="km-caravan-actions">
                                {{#if recallable}}{{#if @root.isGM}}
                                    <button type="button" class="km-btn-sm" data-action="recall-shipment" data-shipment-id="{{id}}">{{localizeKM "kingdom.caravans.recall"}}</button>
                                {{/if}}{{/if}}
                            </span>
                        </li>
                    {{/each}}
                </ul>
            {{/if}}
            {{#unless caravans.length}}
                {{#unless shipments.length}}
                    <p>{{localizeKM "kingdom.caravans.none"}}</p>
                {{/unless}}
            {{/unless}}
        </section>
        <section class="km-kingdom-sheet-section">
            <h2 id="{{actorUuid}}-km-turn-end">{{localizeKM "kingdom.endTurn"}}</h2>
            <p class="km-turn-buttons">
                <button type="button" {{#unless canLevelUp}}disabled{{/unless}} data-action="level-up">{{localizeKM
                        "kingdom.levelUp"}}</button>
                <button type="button" data-action="open-turn-wizard"><i class="fas fa-magic"></i> {{localizeKM "kingdom.turnWizard.openButton"}}</button>
                {{#if isGM}}
                    <button type="button" data-action="end-turn">{{localizeKM "kingdom.endTurn"}}</button>
                {{/if}}
            </p>
        </section>
    </div>
</div>
