<div>
    <div id="km-camping-time-tracker" class="km-row" style="background-position: {{pxTimeOffset}}px">
        {{#if isGM}}
            <div class="km-camping-travel">
                <div class="{{#if night.travelMode}}night-mode{{/if}}" title="{{localizeKM "camping.travelingHelp"}}">
                    {{> formElement travelMode}}
                </div>
                <div class="{{#if night.forcedMarch}}night-mode{{/if}}" title="{{localizeKM "camping.forcedMarchHelp" maxDays=forcedMarchMaxDays days=forcedMarchDays}}">
                    {{> formElement forcedMarch}}
                </div>
            </div>
            <button class="km-camping-action {{#if night.retract2}}night-mode{{/if}}"
                    data-action="advance-hour"
                    type="button"
                    data-hours="-2"
                    title="{{localizeKM "camping.retractHours" count=2}}">
                -2h
            </button>
            <button class="km-camping-action {{#if night.retract1}}night-mode{{/if}}"
                    data-action="advance-hour"
                    type="button"
                    data-hours="-1"
                    title="{{localizeKM "camping.retractHours" count=1}}">
                -1h
            </button>
            <button class="km-camping-action {{#if night.retractHex}}night-mode{{/if}}"
                    id="km-camping-minus-hexploration"
                    type="button"
                    data-action="advance-hexploration"
                    data-activities="-1"
                    title="{{localizeKM "camping.retractHexActivity" duration=hexplorationActivityDuration}}">-1
            </button>
        {{/if}}
        <div id="km-camping-time" class="{{#if night.time}}night-mode{{/if}}">
            <div id="km-camping-time-wrapper">
                {{# isDay}}
                    <i class="fa-regular fa-sun"></i>
                {{else}}
                    <i class="fa-regular fa-moon"></i>
                {{/isDay}}
                <div>{{time}}</div>
            </div>
        </div>
        {{#if isGM}}
            <button class="km-camping-action {{#if night.advanceHex}}night-mode{{/if}}"
                    id="km-camping-plus-hexploration"
                    type="button"
                    data-action="advance-hexploration"
                    data-activities="1"
                    title="{{localizeKM "camping.advanceHexActivity" duration=hexplorationActivityDuration}}">+1
            </button>
            <button class="km-camping-action {{#if night.advance1}}night-mode{{/if}}"
                    data-action="advance-hour"
                    type="button"
                    data-hours="1"
                    title="{{localizeKM "camping.advanceHours" count=1}}">
                +1h
            </button>
            <button class="km-camping-action {{#if night.advance2}}night-mode{{/if}}"
                    data-action="advance-hour"
                    type="button"
                    data-hours="2"
                    title="{{localizeKM "camping.advanceHours" count=2}}">
                +2h
            </button>
            <button class="km-camping-action {{#if night.rest}}night-mode{{/if}}"
                    id="km-camping-rest"
                    type="button"
                    draggable="true"
                    data-action="rest"
                    title="{{#if restDurationLeft}}
                        {{localizeKM "camping.continueUntilFullyRested"}}: {{restDurationLeft}}
                    {{else}}{{localizeKM "camping.restAndDailyPreps"}}: {{restDuration}}{{/if}}{{localizeKM "camping.hoursSymbol"}}"
            >
                {{#if restDurationLeft}}
                    <span>{{localizeKM "camping.continue"}} </span><i class="fa-solid fa-bed"></i>
                {{else}}
                    <span>{{localizeKM "camping.rest"}}</span><i
                        class="fa-solid fa-bed"></i>
                {{/if}}
            </button>
        {{/if}}
    </div>
    <div id="km-camping-hexploration" class="km-row">
        <div id="km-adventuring-for"><b>{{localizeKM "camping.adventuringDuration"}}</b> <span title="{{localizeKM "camping.travelingFor" duration=travelingFor}}">{{adventuringFor}}</span>
            {{#if isGM}}
                <button type="button"
                        data-action="reset-adventuring-for"
                        title="{{localizeKM "camping.resetTimeTracker"}}">
                    <i class="fa-solid fa-rotate-left"></i>
                </button>
            {{/if}}
        </div>
        <div title="{{localizeKM "camping.hexplorationActivities"}}"><b>{{localizeKM "camping.hexActivities"}}:</b> {{hexplorationActivitiesAvailable}}
            /{{hexplorationActivitiesMax}}</div>
        <div>{{> formElement region}}</div>
        {{#if isGM}}
            <div id="km-camping-encounter">
                <button type="button" data-action="increase-encounter-dc" data-value="-1" title="{{localizeKM "camping.decreaseDc"}}">
                    <i class="fa-solid fa-minus"></i></button>
                <div><b>{{localizeKM "camping.encounterDc"}}:</b> {{encounterDc}}</div>
                <button type="button" data-action="increase-encounter-dc" data-value="1" title="{{localizeKM "camping.increaseDc"}}">
                    <i class="fa-solid fa-plus"></i></button>
                <button type="button" data-action="reset-encounter-dc" title="{{localizeKM "camping.resetDc"}}"><i
                        class="fa-solid fa-rotate-left"></i></button>
                <button type="button"
                        {{#unless canRollEncounter}}disabled{{/unless}}
                        data-action="roll-encounter"
                        title="{{localizeKM "camping.randomEncounterRoll"}}"><i
                        class="fa-solid fa-skull"></i></button>
                <button type="button"
                        {{#unless canRollEncounter}}disabled{{/unless}}
                        data-action="check-encounter"
                        title="{{localizeKM "camping.randomEncounterCheck"}}"><i
                        class="fa-solid fa-dice-d20"></i><i
                        class="fa-solid fa-skull"></i></button>
            </div>
        {{/if}}
    </div>
    <ul class="km-camping-actors">
        {{#each actors}}
            <li class="km-camping-actor" draggable="true" data-uuid="{{uuid}}" data-type="Actor">
                <a href="#" draggable="false" data-uuid="{{uuid}}" data-action="open-actor"{{#if learnedActivities}} data-tooltip="{{learnedActivities}}" data-tooltip-direction="UP"{{/if}}><img draggable="false" src="{{image}}" alt="{{name}}"></a>
                {{#if choseActivity}}
                    <div class="taken-camping-activity"><i class="fa-solid fa-circle-check"></i></div>
                {{/if}}
                {{#if chosenMealImg}}
                    <img class="chosen-meal" src="{{chosenMealImg}}" alt="{{chosenMeal}}" title="{{chosenMeal}}">
                {{/if}}
                {{#if downtimeHoursMax}}
                    <div class="km-camping-actor-hours{{#if downtimeBudgetFull}} km-camping-actor-hours-full{{/if}}"
                         title="{{localizeKM "camping.downtimeBudgetHelp" max=downtimeHoursMax}}">
                        {{downtimeHoursRemaining}}<span class="km-hours-unit">{{localizeKM "camping.hoursSymbol"}}</span>
                    </div>
                {{/if}}
                {{#if hungryDays}}
                    <div class="km-camping-actor-hungry{{#if hungryCritical}} km-camping-actor-hungry-critical{{/if}}"
                         title="{{localizeKM "camping.hungryDaysHelp" days=hungryDays}}">
                        <i class="fa-solid fa-drumstick-bite"></i>{{hungryDays}}
                    </div>
                {{/if}}
                <button class="km-camping-action"
                        data-action="clear-actor"
                        type="button"
                        data-uuid="{{uuid}}">
                    <i class="fa-regular fa-circle-xmark"></i>
                </button>
            </li>
        {{/each}}
        <li class="km-camping-add-actor">
            <span>{{localizeKM "camping.dropActorFromSidebar"}}</span>
            <i class="fa-solid fa-plus"></i>
        </li>
    </ul>
    <!-- add km-camping-day class to switch to different bg-->
    <div id="km-camping-content" style="background-image: url({{sheetBackground}})">
        <button class="km-camping-previous"
                data-action="previous-section"
            {{#unless isGM}}hidden{{/unless}}
            {{#if prepareCampSection}}hidden{{/if}}
                type="button"><i class="fa-solid fa-chevron-left"></i>
        </button>
        <button {{#if setWatchesSection}}hidden{{/if}}
                class="km-camping-next"
                {{#unless isGM}}hidden{{/unless}}
                data-action="next-section"
                type="button"><i class="fa-solid fa-chevron-right"></i></button>
        <div {{#unless eatingSection}}hidden{{/unless}} class="km-camping-eating-total">
            <span class="km-food-days{{#unless foodTonightCovered}} km-food-days-warn{{/unless}}"
                  title="{{localizeKM "camping.foodDaysHelp"}}">
                <b>{{localizeKM "camping.foodDays"}}:</b> {{foodDaysDisplay}}
            </span>
            <span>
                {{> foodCost availableFood hideEmpty=false title="camping.available"}}
            </span>
            <hr>
            <span>
                {{> foodCost totalFoodCost hideEmpty=false title="camping.uncookedCost"}}
            </span>
        </div>
        <div id="km-camping-content-wrapper">
            {{> rumorBoard this}}
            <div class="km-camping-activities-wrapper">
{{#if forcedMarchOverLimit}}
                <div class="km-forced-march-banner">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    {{localizeKM "camping.forcedMarchOverLimitBanner" days=forcedMarchDays maxDays=forcedMarchMaxDays}}
                </div>
                {{/if}}
                                <details class="km-route-planner" {{#if travelStartHexSelect.value}}open{{/if}}>
                    <summary><i class="fa-solid fa-map-directions"></i> {{localizeKM "camping.routePlanner"}}</summary>
                    <div class="km-route-planner-content">
                        <div class="km-row">
                            <div class="km-form-group">
                                {{> formElement travelStartHexSelect}}
                            </div>
                            <div class="km-form-group">
                                {{> formElement travelEndHexSelect}}
                            </div>
                        </div>
                        {{#if travelRoute}}
                            <div class="km-route-details">
                                {{#if travelRoute.foodWarning}}
                                <div class="km-route-food-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{travelRoute.foodWarning}}</div>
                                {{/if}}
                                <div class="km-row km-route-summary">
                                    <div><b>{{localizeKM "camping.totalCost"}}:</b> {{travelRoute.totalCost}} {{localizeKM "camping.activitiesSymbol"}}</div>
                                    <div><b>{{localizeKM "camping.estimatedDuration"}}:</b> {{travelRoute.estimatedDuration}}</div>
                                    <div><b>{{localizeKM "camping.totalDistance"}}:</b> {{travelRoute.totalDistance}} {{localizeKM "kingdom.hex" count=travelRoute.totalDistance}}</div>
                                    <div class="km-route-speed">
                                        <b>{{localizeKM "camping.travelSpeedLabel"}}:</b> {{travelRoute.travelSpeedLabel}}
                                        <i class="fa-solid fa-circle-info km-route-speed-info"
                                           data-tooltip="{{travelRoute.travelSpeedTooltip}}"
                                           data-tooltip-direction="UP"
                                           aria-label="{{localizeKM "camping.travelSpeedHelpTitle"}}"></i>
                                    </div>
                                </div>
                                {{#if isGM}}
                                <div class="km-route-actions">
                                    <button type="button" data-action="travel-route">
                                        <i class="fa-solid fa-person-hiking"></i> {{localizeKM "camping.travelRoute"}}
                                    </button>
                                    <label class="km-route-move-token">
                                        <input type="checkbox" name="travelMoveToken" {{#if travelMoveToken}}checked{{/if}}>
                                        {{localizeKM "camping.travelRouteMoveToken"}}
                                    </label>
                                </div>
                                {{/if}}
                                <details class="km-route-speed-help">
                                    <summary>{{localizeKM "camping.travelSpeedHelpTitle"}}</summary>
                                    <ul>
                                        {{#each travelRoute.travelSpeedDetails}}
                                            <li>{{this}}</li>
                                        {{/each}}
                                    </ul>
                                </details>
                {{> downtimeProjects this}}
                                <div class="km-route-modifiers">
                                    <b>{{localizeKM "camping.routeModifiers"}}:</b>
                                    <ul>
                                        {{#each travelRoute.modifiers}}
                                            <li>{{this}}</li>
                                        {{/each}}
                                    </ul>
                                </div>
                            </div>
                        {{else}}
                            {{#if travelPathError}}
                                <div class="km-route-error">{{travelPathError}}</div>
                            {{/if}}
                        {{/if}}
                    </div>
                </details>

                <details class="km-travel-log">
                    <summary><i class="fa-solid fa-scroll"></i> {{localizeKM "camping.travelLog"}}{{#if travelJournalRows}} ({{travelJournalCount}}){{/if}}</summary>
                    <div class="km-travel-log-content">
                        {{#if travelJournalRows}}
                            <ul class="km-travel-log-entries">
                                {{#each travelJournalRows}}
                                    <li class="km-travel-log-entry km-travel-log-{{kindValue}}">
                                        <span class="km-travel-log-date">{{worldDate}}</span>
                                        <span class="km-travel-log-kind">{{kindLabel}}</span>
                                        <span class="km-travel-log-detail">{{detail}}</span>
                                    </li>
                                {{/each}}
                            </ul>
                        {{else}}
                            <p class="km-travel-log-empty">{{localizeKM "camping.travelLogEmpty"}}</p>
                        {{/if}}
                    </div>
                </details>

                <h1>{{section}}</h1>
                {{#if setWatchesSection}}
                <div class="km-camping-watch-controls">
                    {{> formElement numberOfWatches}}
                    <button type="button" class="km-camping-action" data-action="suggest-watch-order"
                            title="{{localizeKM "camping.suggestWatchOrderHelp"}}">
                        <i class="fa-solid fa-wand-magic-sparkles"></i> {{localizeKM "camping.suggestWatchOrder"}}
                    </button>
                </div>
                {{#if watchWarnings}}
                <div class="km-camping-watch-warnings">
                    {{#each watchWarnings}}
                    <p><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</p>
                    {{/each}}
                </div>
                {{/if}}
                <div class="km-camping-watch-grid">
                    {{#each watchSlots}}
                    <div class="km-camping-watch-slot" data-slot-index="{{index}}">
                        <div class="km-camping-watch-slot-header">{{localizeKM "camping.watchSlot"}} {{add index 1}}{{#if hourRange}}
                            <span class="km-camping-watch-hours">{{hourRange}}</span>{{/if}}</div>
                        {{#if actors}}
                        <div class="km-camping-watch-assignees">
                            {{#each actors}}
                            <div class="km-camping-watch-assignee" draggable="true" data-type="Actor" data-uuid="{{uuid}}">
                                <img src="{{image}}" alt="{{name}}">
                                <span>{{name}}</span>
                                {{#if perceptionLabel}}
                                <span class="km-camping-watch-perception"
                                      title="{{localizeKM "camping.watchPerception"}}">{{perceptionLabel}}</span>
                                {{/if}}
                                <button class="km-camping-action"
                                        data-action="clear-watch-slot"
                                        type="button"
                                        data-slot-index="{{../index}}"
                                        data-uuid="{{uuid}}">
                                    <i class="fa-regular fa-circle-xmark"></i>
                                </button>
                            </div>
                            {{/each}}
                        </div>
                        {{else}}
                        <div class="km-camping-watch-empty">
                            <i class="fa-solid fa-shield-halved"></i>
                            <span>{{localizeKM "camping.dropActorOnWatch"}}</span>
                        </div>
                        {{/if}}
                    </div>
                    {{/each}}
                </div>
                {{else}}
                {{#if needsCookAssignment}}
                <div class="km-camping-cook-hint">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>{{localizeKM "camping.assignCookHint"}}</span>
                </div>
                {{/if}}
                <div class="km-camping-activities">
                    {{> campingTile prepareCamp}}
                    {{#each activities}}
                        {{> campingTile this}}
                    {{/each}}
                    {{#each recipes}}
                        {{> recipeTile }}
                    {{/each}}
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</div>
