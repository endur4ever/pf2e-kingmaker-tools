<div class="km-camping-activity km-camping-tile{{#if disabled}} disabled{{/if}}"
    {{#if hidden}}hidden{{/if}}
    {{#if actor}}data-actor-uuid="{{actor.uuid}}"{{/if}}
     data-activity-id="{{id}}"
    {{#if disabledReason}}title="{{disabledReason}}"{{/if}}
>
    <header>
        {{#if journalUuid}}
            <a href="#" data-uuid="{{journalUuid}}" data-action="open-journal">{{name}}</a>
        {{else}}
            {{name}}
        {{/if}}
    </header>
    <div class="km-camping-tile-portrait {{#unless requiresCheck}}km-no-skill-check{{/unless}}">
        {{#if actor}}
            <button class="km-camping-action"
                    data-action="clear-activity"
                    type="button"
                    data-id="{{id}}"><i
                    class="fa-regular fa-circle-xmark"></i></button>
            <a href="#"
               data-uuid="{{actor.uuid}}"
               data-action="open-actor"><img class="cover" src="{{actor.image}}"></a>
        {{else}}
            <div class="empty-activity">
                <header>{{localizeKM "camping.dropActorAbove"}}</header>
                <i class="fa-solid fa-plus"></i>
            </div>
        {{/if}}
    </div>
    {{#if learnTarget}}
        <div class="km-camping-tile-learn">
            {{> formElement learnTarget }}
        </div>
    {{/if}}
    {{#unless requiresCheck}}
        {{#if actor}}
            {{! No-check activities charge downtime on drop and can be repeated: + performs
                it again (2h each), the undo arrow removes one repetition and refunds it
                (unassigning on the last). Sits in the slot where rolled tiles show the d20. }}
            <div class="km-camping-tile-check km-no-check-controls">
                <button class="km-camping-action km-tile-check" data-action="remove-activity-repetition" type="button"
                        data-id="{{id}}" title="{{localizeKM "camping.removeActivityRepetition"}}">
                    <i class="fa-solid fa-rotate-left"></i>
                </button>
                <span class="km-activity-repetitions"
                      title="{{localizeKM "camping.activityRepetitions"}}">&times;{{repetitions}} ({{repetitionHours}}h)</span>
                <button class="km-camping-action km-tile-check" data-action="repeat-activity" type="button"
                        data-id="{{id}}" {{#if repeatDisabled}}disabled{{/if}}
                        title="{{localizeKM "camping.repeatActivity"}}">
                    <i class="fa-solid fa-plus"></i>
                </button>
            </div>
        {{/if}}
    {{/unless}}
    {{#if requiresCheck}}
        <div class="km-camping-tile-check">
            {{> formElement skills }}
            <button class="km-camping-action km-tile-check" data-action="roll-camping-check" type="button"
                    {{#unless actor}}disabled{{/unless}}
                    {{#if disabled}}disabled{{/if}}>
                <i class="fa-solid fa-dice-d20"></i>
            </button>
        </div>
        <div class="km-camping-tile-result" {{#unless secret}}hidden{{/unless}}>
            <select disabled>
                <option>-</option>
                <option {{#if actor}}{{#if actor.degreeOfSuccess.value}}selected{{/if}}{{/if}}>???</option>
            </select>
        </div>
        <div class="km-camping-tile-result" {{#if secret}}hidden{{/if}}>
            {{#if actor}}
                {{> formElement actor.degreeOfSuccess }}
            {{else}}
                <select disabled>
                    <option>-</option>
                </select>
            {{/if}}
        </div>
    {{/if}}
</div>